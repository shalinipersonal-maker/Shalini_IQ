// ENTRAIQ production data model (PostgreSQL).
// Not used by demo mode, which runs entirely on generated sample data in the browser.
// Tenant isolation: every business row carries organizationId (the agency) and, where it belongs
// to one client, clientId. See docs/DATABASE.md for the row-level security policy that enforces this.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Marketplace {
  AMAZON
  FLIPKART
}

enum AdPlatform {
  AMAZON_ADS
  FLIPKART_ADS
  META
}

enum ConnectionStatus {
  PENDING_CONFIGURATION
  AUTHORIZED
  EXPIRED
  REVOKED
  ERROR
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  DRAFT
  ARCHIVED
}

enum ClientStatus {
  ACTIVE
  ONBOARDING
  PAUSED
  CHURNED
}

enum UserStatus {
  ACTIVE
  INVITED
  DEACTIVATED
}

// ---------- Identity and access ----------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Kolkata")
  brand     Json? // product name, tagline, accent
  createdAt DateTime @default(now())

  users         User[]
  roles         Role[]
  clients       Client[]
  employees     Employee[]
  notifications Notification[]
  auditLogs     AuditLog[]
  templates     CreativeTemplate[]
}

model User {
  id             String     @id @default(cuid())
  organizationId String
  email          String     @unique
  name           String
  passwordHash   String? // null when the user signs in through an identity provider
  status         UserStatus @default(INVITED)
  roleId         String
  // A client-portal user is restricted to exactly one client; null for agency staff.
  clientId       String?
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role          Role           @relation(fields: [roleId], references: [id])
  client        Client?        @relation(fields: [clientId], references: [id])
  employee      Employee?
  notifications Notification[]
  auditLogs     AuditLog[]
  reports       Report[]

  @@index([organizationId])
}

model Role {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  system         Boolean @default(false) // built-in roles cannot be deleted

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  permissions  RolePermission[]

  @@unique([organizationId, name])
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique // e.g. "campaigns.edit"
  description String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Employee {
  id             String @id @default(cuid())
  organizationId String
  userId         String @unique
  title          String

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments  ClientAssignment[]

  @@index([organizationId])
}

// ---------- Clients ----------

model Client {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  industry       String
  city           String?
  status         ClientStatus @default(ONBOARDING)
  contactName    String?
  contactEmail   String?
  retainerInr    Int?
  createdAt      DateTime     @default(now())

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  portalUsers         User[]
  assignments         ClientAssignment[]
  marketplaceAccounts MarketplaceAccount[]
  advertisingAccounts AdvertisingAccount[]
  products            Product[]
  orders              Order[]
  salesMetrics        SalesMetric[]
  campaigns           Campaign[]
  recommendations     AiRecommendation[]
  creativeProjects    CreativeProject[]
  creativeAssets      CreativeAsset[]
  leads               Lead[]
  reports             Report[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ClientAssignment {
  clientId   String
  employeeId String
  assignedAt DateTime @default(now())

  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([clientId, employeeId])
}

// ---------- Connected accounts ----------

model MarketplaceAccount {
  id                String           @id @default(cuid())
  organizationId    String
  clientId          String
  marketplace       Marketplace
  externalSellerId  String?
  status            ConnectionStatus @default(PENDING_CONFIGURATION)
  // AES-256-GCM envelope produced by src/server/connectors/token-vault.ts. Never plaintext.
  accessTokenEnc    String?
  refreshTokenEnc   String?
  tokenExpiresAt    DateTime?
  lastSyncAt        DateTime?
  createdAt         DateTime         @default(now())

  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  products  Product[]
  orders    Order[]
  inventory Inventory[]
  syncLogs  SyncLog[]

  @@unique([clientId, marketplace, externalSellerId])
  @@index([organizationId, clientId])
}

model AdvertisingAccount {
  id                String           @id @default(cuid())
  organizationId    String
  clientId          String
  platform          AdPlatform
  externalAccountId String?
  status            ConnectionStatus @default(PENDING_CONFIGURATION)
  accessTokenEnc    String?
  refreshTokenEnc   String?
  tokenExpiresAt    DateTime?
  lastSyncAt        DateTime?
  createdAt         DateTime         @default(now())

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  syncLogs  SyncLog[]

  @@unique([clientId, platform, externalAccountId])
  @@index([organizationId, clientId])
}

model SyncLog {
  id                   String   @id @default(cuid())
  organizationId       String
  marketplaceAccountId String?
  advertisingAccountId String?
  resource             String // "orders", "campaign_metrics", ...
  status               String // success | partial | failed
  records              Int      @default(0)
  attempts             Int      @default(1)
  error                String?
  startedAt            DateTime
  finishedAt           DateTime

  marketplaceAccount MarketplaceAccount? @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  advertisingAccount AdvertisingAccount? @relation(fields: [advertisingAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
}

// ---------- Catalogue, orders, sales ----------

model Product {
  id                   String  @id @default(cuid())
  organizationId       String
  clientId             String
  marketplaceAccountId String?
  sku                  String
  name                 String
  category             String?
  imageUrl             String?
  externalId           String? // ASIN / FSN
  priceInr             Decimal @db.Decimal(12, 2)
  mrpInr               Decimal? @db.Decimal(12, 2)
  active               Boolean @default(true)

  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  marketplaceAccount MarketplaceAccount? @relation(fields: [marketplaceAccountId], references: [id])
  orderItems         OrderItem[]
  salesMetrics       SalesMetric[]
  inventory          Inventory[]

  @@unique([clientId, marketplaceAccountId, sku])
  @@index([organizationId, clientId])
}

model Order {
  id                   String   @id @default(cuid())
  organizationId       String
  clientId             String
  marketplaceAccountId String
  externalOrderId      String
  status               String
  totalInr             Decimal  @db.Decimal(12, 2)
  placedAt             DateTime

  client             Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  marketplaceAccount MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  items              OrderItem[]

  @@unique([marketplaceAccountId, externalOrderId])
  @@index([organizationId, clientId, placedAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  quantity     Int
  unitPriceInr Decimal @db.Decimal(12, 2)
  returned     Boolean @default(false)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
}

/// One row per product × marketplace × day. Source of truth for every sales chart.
model SalesMetric {
  id             String      @id @default(cuid())
  organizationId String
  clientId       String
  productId      String
  marketplace    Marketplace
  date           DateTime    @db.Date
  units          Int
  orders         Int
  revenueInr     Decimal     @db.Decimal(14, 2)
  sessions       Int         @default(0)
  returns        Int         @default(0)
  cancellations  Int         @default(0)

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, marketplace, date])
  @@index([organizationId, clientId, date])
}

model Inventory {
  id                   String   @id @default(cuid())
  organizationId       String
  productId            String
  marketplaceAccountId String
  onHand               Int
  inbound              Int      @default(0)
  leadTimeDays         Int      @default(12)
  updatedAt            DateTime @updatedAt

  product            Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplaceAccount MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)

  @@unique([productId, marketplaceAccountId])
  @@index([organizationId])
}

// ---------- Advertising ----------

model Campaign {
  id                   String         @id @default(cuid())
  organizationId       String
  clientId             String
  advertisingAccountId String
  externalId           String?
  name                 String
  objective            String
  status               CampaignStatus @default(DRAFT)
  dailyBudgetInr       Decimal        @db.Decimal(12, 2)
  startDate            DateTime?      @db.Date
  endDate              DateTime?      @db.Date

  client             Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  advertisingAccount AdvertisingAccount @relation(fields: [advertisingAccountId], references: [id], onDelete: Cascade)
  adSets             AdSet[]
  metrics            CampaignMetric[]

  @@unique([advertisingAccountId, externalId])
  @@index([organizationId, clientId])
}

model AdSet {
  id         String  @id @default(cuid())
  campaignId String
  externalId String?
  name       String
  audience   String?

  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads      Ad[]
  metrics  CampaignMetric[]

  @@index([campaignId])
}

model Ad {
  id         String  @id @default(cuid())
  adSetId    String
  externalId String?
  name       String
  format     String?
  creativeProjectId String?

  adSet           AdSet            @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  creativeProject CreativeProject? @relation(fields: [creativeProjectId], references: [id])
  metrics         CampaignMetric[]

  @@index([adSetId])
}

/// Delivery at the lowest level the platform reports (ad for Meta, campaign for marketplace ads), per day.
/// Ad set and campaign totals are always derived by summing these rows, so the levels cannot disagree.
model CampaignMetric {
  id                   String   @id @default(cuid())
  organizationId       String
  campaignId           String
  adSetId              String?
  adId                 String?
  date                 DateTime @db.Date
  spendInr             Decimal  @db.Decimal(14, 2)
  impressions          Int
  reach                Int      @default(0)
  clicks               Int
  conversions          Int
  attributedRevenueInr Decimal  @db.Decimal(14, 2)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adSet    AdSet?   @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  ad       Ad?      @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([campaignId, adSetId, adId, date])
  @@index([organizationId, date])
}

// ---------- AI ----------

model AiRecommendation {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  category       String
  kind           String // risk | opportunity | info
  title          String
  explanation    String
  metrics        Json
  impact         String
  action         String
  confidence     Float?
  provider       String // "demo-rules" or the hosted model identifier
  periodFrom     DateTime  @db.Date
  periodTo       DateTime  @db.Date
  reviewedAt     DateTime?
  reviewedById   String?
  createdAt      DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, clientId, createdAt])
}

// ---------- Creative Studio ----------

model CreativeTemplate {
  id             String  @id @default(cuid())
  organizationId String? // null = built-in template available to every organisation
  name           String
  category       String
  placement      String
  width          Int
  height         Int
  document       Json

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     CreativeProject[]
}

model CreativeProject {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  templateId     String?
  name           String
  placement      String
  width          Int
  height         Int
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client   Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template CreativeTemplate? @relation(fields: [templateId], references: [id])
  versions CreativeVersion[]
  ads      Ad[]

  @@index([organizationId, clientId])
}

model CreativeVersion {
  id          String   @id @default(cuid())
  projectId   String
  number      Int
  document    Json // layers, as in src/lib/studio/types.ts
  exportKey   String? // object-storage key of the rendered PNG/JPEG
  createdById String
  createdAt   DateTime @default(now())

  project CreativeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
}

model CreativeAsset {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  kind           String // upload | logo | brand
  name           String
  storageKey     String // S3-compatible object key, scoped as org/{organizationId}/client/{clientId}/...
  mimeType       String
  width          Int?
  height         Int?
  bytes          Int
  createdAt      DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, clientId])
}

// ---------- Leads, reports, notifications, audit ----------

model Lead {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  source         String // e.g. "meta_lead_form"
  campaignRef    String?
  name           String?
  email          String?
  phone          String?
  status         String   @default("new")
  createdAt      DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, clientId, createdAt])
}

model Report {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  type           String
  title          String
  format         String // CSV | PDF
  periodFrom     DateTime @db.Date
  periodTo       DateTime @db.Date
  filters        Json?
  storageKey     String?
  rowCount       Int
  createdById    String
  createdAt      DateTime @default(now())

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([organizationId, clientId, createdAt])
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  kind           String
  title          String
  href           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

/// Append-only. The application role has INSERT and SELECT only on this table.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  clientId       String?
  action         String
  target         String
  metadata       Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}
