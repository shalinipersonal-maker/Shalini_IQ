# ENTRAIQ environment — copy to .env (or .env.local for `next dev`) and fill in as needed.
# The demo runs with NONE of these set. Add them only as you move toward live data.

# ── Runtime mode ────────────────────────────────────────────────────────────
# Demo mode is ON unless this is exactly "false". Keep "true" until live data is wired.
NEXT_PUBLIC_DEMO_MODE=true

# ── Database (production data layer) ────────────────────────────────────────
# Required only once you build the DB-backed layer / run Prisma migrations.
# docker compose --profile db: postgresql://entraiq:entraiq@db:5432/entraiq
DATABASE_URL=

# POSTGRES_* are read by the bundled Postgres service in docker-compose.yml.
POSTGRES_USER=entraiq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=entraiq

# ── Token vault (encryption of marketplace/ad tokens at rest) ───────────────
# base64 of 32 random bytes. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ── Marketplace & advertising connectors ────────────────────────────────────
# Setting these only moves a connector from "pending configuration" to
# "configured, not authorised". Token exchange & sync are not implemented in
# this build — see docs/API_INTEGRATIONS.md.
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_APP_ID=

AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=

FLIPKART_APP_ID=
FLIPKART_APP_SECRET=

META_APP_ID=
META_APP_SECRET=

# ── Website lead alerts ─────────────────────────────────────────────────────
# Demo requests and sign-ups from the public website are POSTed here as JSON
# ({ text, reference, lead }). Works with Slack / Google Chat incoming webhooks,
# n8n, Make, Zapier, or a Google Apps Script web app that emails the team and
# appends to a sheet. Leave empty and the site reports alerts as
# "pending configuration" — it never claims an alert was sent.
LEAD_WEBHOOK_URL=

# ── Public website ──────────────────────────────────────────────────────────
# The live address of the website (no trailing slash). Used for SEO: sitemap,
# canonical links and social-media preview cards.
NEXT_PUBLIC_SITE_URL=https://entrabuild.com

# ── LIVE TEST (/account) ────────────────────────────────────────────────────
# Real sign-in, enquiry alerts, Facebook/Instagram posting and sales uploads.
# Set these in Vercel → Project → Settings → Environment Variables. Never commit values.
# Postgres from Vercel → Storage → Neon (added automatically when you connect it).
DATABASE_URL=
# Who may sign in, comma-separated (they can also see website enquiries).
LIVE_ALLOWED_EMAILS=
# Long random string: openssl rand -base64 32
SESSION_SECRET=
# Email through resend.com (domain verified there). MAIL_FROM e.g. ENTRAIQ <hello@entrabuild.com>
RESEND_API_KEY=
MAIL_FROM=
# New enquiries are emailed here.
ALERT_EMAIL=
# TOKEN_ENCRYPTION_KEY (above) must also be set: it encrypts Meta access tokens.
# Meta app (developers.facebook.com). META_APP_ID / META_APP_SECRET are above.
# Business-type apps: the "Facebook Login for Business" configuration ID.
META_CONFIG_ID=
META_GRAPH_VERSION=v23.0

# ── MORE CONNECTIONS (/account) ─────────────────────────────────────────────
# Threads: Meta app → Use cases → "Access the Threads API" → Settings shows its own app id/secret.
# Redirect callback to add there:  https://<your-site>/api/threads/callback
THREADS_APP_ID=
THREADS_APP_SECRET=
# Amazon (private developer, self-authorised): Seller Central → Apps and Services → Develop Apps.
# AMAZON_SP_CLIENT_ID / AMAZON_SP_CLIENT_SECRET are above; the refresh token comes from "Authorize app".
AMAZON_SP_REFRESH_TOKEN=
# Optional overrides (defaults: India marketplace on the EU endpoint)
AMAZON_SP_MARKETPLACE_ID=A21TJRUUN4KGV
AMAZON_SP_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
# Flipkart self-access: Seller Hub → Manage Profile → Developer Access (FLIPKART_APP_ID / FLIPKART_APP_SECRET above).

# ── IQ ON TELEGRAM + MORNING REPORT ─────────────────────────────────────────
# Telegram → @BotFather → /newbot → copy the token.
TELEGRAM_BOT_TOKEN=
# Message your bot "/start"; it replies with your chat id. Only this chat gets business data.
TELEGRAM_CHAT_ID=
# Any long random text. Vercel sends it to the daily 9 AM report job (vercel.json → /api/cron/daily).
CRON_SECRET=

# ── SHOPIFY ─────────────────────────────────────────────────────────────────
# Store address (Shopify admin → Settings → Domains shows the .myshopify.com one).
SHOPIFY_STORE_DOMAIN=
# Dev Dashboard app (dev.shopify.com → Apps → Create app → scopes read_orders, read_products → install on the store)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Only if the store still has an older custom-app token (shpat_…); otherwise leave empty.
SHOPIFY_ADMIN_TOKEN=
